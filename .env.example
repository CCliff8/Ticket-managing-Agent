# Classifier backend: ollama, groq
CLASSIFIER_BACKEND=ollama
CLASSIFIER_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Groq (only needed if CLASSIFIER_BACKEND=groq)
GROQ_API_KEY=

# Anthropic (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Resolver models
RESOLVER_MODEL_LOW=claude-haiku-4-5-20251001
RESOLVER_MODEL_HIGH=claude-sonnet-4-6

# Email (Gmail SMTP — use an App Password, not your account password)
# Guide: https://support.google.com/accounts/answer/185833
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
HUMAN_REVIEW_EMAIL=reviewer@example.com

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
RUNBOOKS_DIR=./runbooks

# Routing thresholds (0.0 – 1.0)
AUTO_RESOLVE_CONFIDENCE=0.8
DRAFT_REVIEW_CONFIDENCE=0.5
